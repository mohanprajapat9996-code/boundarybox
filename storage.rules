rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'YOUR_ADMIN_EMAIL@example.com';
    }
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /downloads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
